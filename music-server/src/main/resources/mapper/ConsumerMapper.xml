<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.yin.mapper.ConsumerMapper">
  <resultMap id="BaseResultMap" type="com.example.yin.model.domain.Consumer">
    <result column="id" property="id" jdbcType="INTEGER" />
    <result column="username" property="username" jdbcType="VARCHAR" />
    <result column="password" property="password" jdbcType="VARCHAR" />
    <result column="sex" property="sex" jdbcType="TINYINT" />
    <result column="phone_num" property="phoneNum" jdbcType="CHAR" />
    <result column="email" property="email" jdbcType="CHAR" />
    <result column="birth" property="birth" jdbcType="TIMESTAMP" />
    <result column="introduction" property="introduction" jdbcType="VARCHAR" />
    <result column="location" property="location" jdbcType="VARCHAR" />
    <result column="avator" property="avator" jdbcType="VARCHAR" />
    <result column="nickname" property="nickname" jdbcType="VARCHAR" />
    <result column="status" property="status" jdbcType="TINYINT" />
    <result column="org_id" property="orgId" jdbcType="INTEGER" />
    <result column="last_login_time" property="lastLoginTime" jdbcType="TIMESTAMP" />
    <result column="create_time" property="createTime" jdbcType="TIMESTAMP" />
    <result column="update_time" property="updateTime" jdbcType="TIMESTAMP" />
  </resultMap>
  <resultMap id="UserWithRolesResultMap" type="com.example.yin.model.domain.Consumer" extends="BaseResultMap">
    <collection property="roles" ofType="com.example.yin.model.domain.Role">
      <id column="role_id" property="id" />
      <result column="role_name" property="name" />
      <result column="role_code" property="code" />
    </collection>
  </resultMap>

  <sql id="User_Role_Column_List">
    c.id, c.username, c.password, c.sex, c.phone_num, c.email, c.birth, c.introduction, c.location, c.avator, c.nickname, c.status, c.org_id, c.last_login_time, c.create_time, c.update_time,
    r.id as role_id, r.name as role_name, r.code as role_code
  </sql>

  <select id="selectListWithRoles" resultMap="UserWithRolesResultMap">
    select
    <include refid="User_Role_Column_List" />
    from consumer c
    left join user_role ur on c.id = ur.user_id and ur.user_type = 'consumer'
    left join role r on ur.role_id = r.id
  </select>

  <select id="selectByIdWithRoles" resultMap="UserWithRolesResultMap">
    select
    <include refid="User_Role_Column_List" />
    from consumer c
    left join user_role ur on c.id = ur.user_id and ur.user_type = 'consumer'
    left join role r on ur.role_id = r.id
    where c.id = #{id}
  </select>
</mapper>
