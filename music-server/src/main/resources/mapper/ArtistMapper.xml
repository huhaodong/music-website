<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.yin.mapper.ArtistMapper">
  <resultMap id="BaseResultMap" type="com.example.yin.model.domain.Artist">
    <id column="id" property="id" jdbcType="INTEGER" />
    <result column="name" property="name" jdbcType="VARCHAR" />
    <result column="types_json" property="typesJson" jdbcType="VARCHAR" />
    <result column="sex" property="sex" jdbcType="TINYINT" />
    <result column="pic" property="pic" jdbcType="VARCHAR" />
    <result column="birth" property="birth" jdbcType="TIMESTAMP" />
    <result column="location" property="location" jdbcType="VARCHAR" />
    <result column="introduction" property="introduction" jdbcType="VARCHAR" />
    <result column="create_time" property="createTime" jdbcType="TIMESTAMP" />
    <result column="update_time" property="updateTime" jdbcType="TIMESTAMP" />
  </resultMap>

  <sql id="Base_Column_List">
    id, name, types_json, sex, pic, birth, location, introduction, create_time, update_time
  </sql>

  <select id="selectAssociatedProjects" resultType="java.util.HashMap">
    SELECT
      p.id            AS id,
      p.org_id        AS orgId,
      p.name          AS name,
      p.status        AS status,
      pa.role         AS role
    FROM project_artist pa
    INNER JOIN project p ON p.id = pa.project_id
    WHERE pa.artist_id = #{artistId}
      AND p.deleted = 0
    ORDER BY p.id DESC, pa.role ASC
  </select>
</mapper>
